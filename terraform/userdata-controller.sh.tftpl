#!/bin/bash
apt-get update
apt-get install -y ansible git awscli

install -d -m 700 -o ubuntu -g ubuntu /home/ubuntu/.ssh
cat > /home/ubuntu/.ssh/id_ed25519 <<'KEY'
${private_key}
KEY
chmod 600 /home/ubuntu/.ssh/id_ed25519
chown ubuntu:ubuntu /home/ubuntu/.ssh/id_ed25519

cat > /home/ubuntu/inventory.ini <<EOF
[web]
web ansible_host=${web_ip}

[monitoring]
monitoring ansible_host=${monitoring_ip}

[fyp:children]
web
monitoring

[fyp:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/home/ubuntu/.ssh/id_ed25519
EOF
chown ubuntu:ubuntu /home/ubuntu/inventory.ini

# pembolehubah sulit (token Cloudflare Tunnel) — luar repo git supaya
# tidak tertimpa oleh git clone/pull, hantar semasa ansible-playbook dengan
# -e @/etc/devops-fyp/secrets.yml
install -d -m 700 /etc/devops-fyp
cat > /etc/devops-fyp/secrets.yml <<EOF
cloudflare_tunnel_token: "${cloudflare_tunnel_token}"
ecr_repository_url: "${ecr_repository_url}"
EOF
chmod 600 /etc/devops-fyp/secrets.yml
